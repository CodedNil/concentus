{
  "languages": {
    "Rust": {
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "rust-analyzer"
          }
        },
        {
          "external": {
            "command": "topcoat",
            "arguments": [
              "fmt",
              "--stdin"
            ]
          }
        }
      ]
    }
  }
}
